{
  "manifest_version": 3,
  "name": "Wildsea Charsmith - Polish Translation",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Client-side Polish translation overlay for the Wildsea Charsmith web app. Translations are loaded from a local JSON file.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://wildsea.charsmith.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Wildsea Polish Translation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wildsea.charsmith.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "translations.json"
      ],
      "matches": [
        "https://wildsea.charsmith.com/*"
      ]
    }
  ]
}
